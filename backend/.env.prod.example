# ──────────────────────────────────────────────
# Production environment template
# Copy to .env.prod and edit all values before deploying.
#   cp .env.prod.example .env.prod
# ──────────────────────────────────────────────

# ── Server ──
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# ── PostgreSQL (used by docker-compose.prod.yml) ──
POSTGRES_USER=market
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=market
# Internal DATABASE_URL is assembled by docker-compose.prod.yml.
# You do NOT need to set DATABASE_URL separately.

# ── Security keys (REQUIRED) ──
# MARKET_ACCESS_KEY: the key the Electron app sends to authenticate API requests.
#   Must match the "marketServerKey" in the app's localStorage settings.
#   Use a long random string (≥ 32 characters).
MARKET_ACCESS_KEY=CHANGE_ME_long_random_access_key_here_at_least_32_chars
# JWT_SECRET: used to sign JWT tokens. Must be ≥ 32 characters.
JWT_SECRET=CHANGE_ME_long_random_jwt_secret_here_at_least_32_chars

# ── Storage ──
STORAGE_DIR=/app/storage
HOST_STORAGE_DIR=./storage
MAX_UPLOAD_MB=250
MAX_ARCHIVE_ENTRIES=10000
MAX_UNCOMPRESSED_MB=1024
MAX_ARCHIVE_ENTRY_MB=100
UPLOAD_CONCURRENCY=1
UPLOAD_QUEUE_MAX=2

# JSON/sync protection. Sync is incremental and paged; these limits prevent
# one malformed request from occupying the API process or a DB transaction.
MAX_JSON_BODY_MB=8
SYNC_PAGE_SIZE=250
SYNC_PAGE_MAX=500
SYNC_BATCH_MAX=50
SYNC_OBJECT_MAX_KB=1024
SYNC_BATCH_MAX_MB=4

# ── CORS ──
# The origin(s) allowed to make browser/Electron requests to this API.
# For Electron apps, set to * or a comma-separated list of allowed origins.
CORS_ORIGIN=*

# ── Rate limiting (relaxed for desktop-app usage) ──
LOGIN_RATE_LIMIT_MAX=60
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_MAX=20
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
DOWNLOAD_RATE_LIMIT_MAX=120
DOWNLOAD_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
PASSWORD_CHANGE_RATE_LIMIT_MAX=10
PASSWORD_CHANGE_RATE_LIMIT_WINDOW_SECONDS=3600
COLLAB_PUSH_RATE_LIMIT_MAX=30
COLLAB_PUSH_RATE_LIMIT_WINDOW_SECONDS=300
INVITATION_VALIDATE_RATE_LIMIT_MAX=30
INVITATION_VALIDATE_RATE_LIMIT_WINDOW_SECONDS=60

# ── Redis (optional; leave empty to disable) ──
REDIS_URL=

# ── Features ──
ALLOW_SELF_REGISTER=true
DECK_CHANGE_TRACKING=false
AUDIT_RETENTION_DAYS=30
AUDIT_ARCHIVE_INTERVAL_HOURS=24
SYNC_HISTORY_RETENTION_DAYS=30
SYNC_HISTORY_KEEP_VERSIONS=5
SYNC_HISTORY_CLEANUP_INTERVAL_HOURS=6
# Keep both cleanup switches off until the retention window has been reviewed.
SYNC_HISTORY_CLEANUP_ENABLED=false
SYNC_TOMBSTONE_RETENTION_DAYS=90
SYNC_TOMBSTONE_CLEANUP_ENABLED=false

# Session tokens. The access-token default stays backward-compatible; lower
# JWT_ACCESS_TTL after the client refresh endpoint is adopted.
JWT_ACCESS_TTL=12h
REFRESH_TOKEN_TTL_DAYS=30

# ── Proxy ──
# Set to true if behind a reverse proxy (nginx, Caddy, etc.) so
# rate limiting and IP detection use the real client IP.
# REQUIRED when using the included nginx.conf — without this,
# all requests appear to come from 127.0.0.1 and rate limiting breaks.
TRUST_PROXY=true
LOG_LEVEL=warn
RATE_LIMIT_MAX_BUCKETS=10000
AUTH_CACHE_MAX_ENTRIES=10000

# Container resource ceilings (docker-compose.prod.yml)
API_MEMORY_LIMIT=512m
API_CPU_LIMIT=0.75
API_PIDS_LIMIT=128
POSTGRES_MEMORY_LIMIT=768m
POSTGRES_CPU_LIMIT=0.75
POSTGRES_PIDS_LIMIT=128

# ── API port (host-side mapping) ──
API_PORT=4000

# ── Admin user creation (used only when running create-admin.js) ──
#   docker compose -f docker-compose.prod.yml --env-file .env.prod run --rm \
#     --entrypoint node api dist/scripts/create-admin.js
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password_min_12_chars
