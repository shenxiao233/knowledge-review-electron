NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://market:market_password@postgres:5432/market?schema=public
MARKET_ACCESS_KEY=replace-with-a-long-random-key
JWT_SECRET=replace-with-another-long-random-secret
STORAGE_DIR=/app/storage
MAX_UPLOAD_MB=250
MAX_ARCHIVE_ENTRIES=10000
MAX_UNCOMPRESSED_MB=1024
MAX_ARCHIVE_ENTRY_MB=100
UPLOAD_CONCURRENCY=1
UPLOAD_QUEUE_MAX=2
MAX_JSON_BODY_MB=8
SYNC_PAGE_SIZE=250
SYNC_PAGE_MAX=500
SYNC_BATCH_MAX=50
SYNC_OBJECT_MAX_KB=1024
SYNC_BATCH_MAX_MB=4
JWT_ACCESS_TTL=12h
REFRESH_TOKEN_TTL_DAYS=30
SYNC_HISTORY_RETENTION_DAYS=30
SYNC_HISTORY_KEEP_VERSIONS=5
SYNC_HISTORY_CLEANUP_INTERVAL_HOURS=6
SYNC_HISTORY_CLEANUP_ENABLED=false
SYNC_TOMBSTONE_RETENTION_DAYS=90
SYNC_TOMBSTONE_CLEANUP_ENABLED=false
LOG_LEVEL=info
RATE_LIMIT_MAX_BUCKETS=10000
AUTH_CACHE_MAX_ENTRIES=10000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
DOWNLOAD_RATE_LIMIT_MAX=30
DOWNLOAD_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT_MAX=5
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=3600
CORS_ORIGIN=http://localhost:5173
# Docker API connection to the existing PostgreSQL container on the host.
DOCKER_DATABASE_URL=postgresql://admin:yang12345@host.docker.internal:5432/mydb?schema=public
# Host path containing the existing deck ZIP files. Relative paths resolve from backend/.
HOST_STORAGE_DIR=./storage
API_PORT=4000
